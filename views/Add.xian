{{headd}}
<form method="Post" action="/insert">
    <label for="LaptopName">LaptopName</label>
    <input type="text" name="LaptopName" placeholder="name"/>
    <label for="Color">Color</label>
    <input type="text" name="Color" placeholder="color" />
    <label for="Specs">Specs</label>
    <input type="text" name="Specs" placeholder="specs" />
    <label for="StorageCapacity">StorageCapacity</label>
    <input type="text" name="StorageCapacity" placeholder="storage" />
    <label for="Price">Price</label>
    <input type="number" step="0.01" name="Price" placeholder="price" />
    <input type="submit" name="save" />
    
</from>