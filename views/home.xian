{{> head }}
<table class="w-full text-left boarder-collapse">
  <thead>
    <tr
    class="bg-gray-50 boarder-b boarder-gray-200 text-xs font-semibold upercase text-gray-500 tracking-wider"
    >
      

      <th class="p-4">id</th>
      <th class="p-4">LaptopName</th>
      <th class="p-4">Color</th>
      <th class="p-4">Specs</th>
      <th class="p-4">StorageCapacity</th>
      <th class="p-4">Price</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-100 text-sm">
    {{#each data}}
    <tr>
      <td>{{ this.id }}</td>
      <td>{{ this.LaptopName }}</td>
      <td>{{ this.Color }}</td>
      <td>{{ this.Specs }}</td>
      <td>{{ this.StorageCapacity }}</td>
      <td>{{ this.Price }}</td>
      <td><a href="/edit/{{ id }}">Edit</a></td>
      <td><a href="/delete/{{ id }}">Delete</a></td>
    </tr>
  {{/each}}
  </tbody>
{{> footer }}
</table>

<a href="/add">Add</a>
{{> footer }}