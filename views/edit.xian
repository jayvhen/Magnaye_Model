{{>head}}
<form method="Post" action="/update/{{ data.id }}">
    <input type="hidden" name="id" placeholder="name" value="{{ data.id }}" />
    <label for="LaptopName">LaptopName</label>
    <input type="text" name="LaptopName" placeholder="name" value="{{ data.LaptopName }}" />
    <label for="Type">Color</label>
    <input type="text" name="Color" placeholder="color" value="{{ data.Color }}" />
    <label for="Specs">Specs</label>
    <input
    type="text"
    name="Specs"
    placeholder="specs"
    value="{{ data.Specs }}"
    />
    <label for="StorageCapacity">StorageCapacity</label>
    <input
    type="text"
    name="StorageCapacity"
    placeholder="storage"
    value="{{ data.StorageCapacity }}"
    />
    <label for="Price">Price</label>
    <input
    type="number"
    step="0.01"
    name="Price"
    placeholder="price"
    value="{{ data.Price }}"
    />
    <input type="submit" name="save" />
</form>